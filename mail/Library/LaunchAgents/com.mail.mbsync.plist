<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mail.mbsync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/mbsync</string>
        <string>-a</string>
    </array>

    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>NetworkState</key>
        <true/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/mbsync.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/mbsync.err</string>
</dict>
</plist>
